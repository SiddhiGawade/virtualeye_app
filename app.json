{
  "expo": {
    "name": "Virtual Eye",
    "slug": "virtual-eye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "virtualeye",
    "description": "A private camera assistant that describes the world aloud.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.virtualeye.app"
    },
    "android": {
      "package": "com.virtualeye.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Virtual Eye uses the camera to understand the world around you.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Virtual Eye uses the microphone to listen for voice commands.",
          "speechRecognitionPermission": "Virtual Eye uses speech recognition to understand voice commands."
        }
      ],
      "expo-router"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}